# Supabase (browser-safe key only — never commit service role / secret key)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable (sb_publishable_...) or legacy anon JWT (eyJ...) from Settings → API Keys
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional build label (runtime uses hostname: web_localhost vs web_github_pages)
# VITE_PLATFORM=web_github_pages

# Optional — defaults to package version at build time if unset
# VITE_GAME_VERSION=0.0.0

# --- GitHub Pages (CI) ---
# Copy .env values into the repo as Actions secrets (Settings → Secrets and variables → Actions):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
# Pushes to `main` run `.github/workflows/deploy-github-pages.yml` and deploy `dist/` to `gh-pages`.
# Local `npm run deploy` uses your `.env` during `npm run build`, or copy
# `public/escape-analytics.json.example` → `public/escape-analytics.json`.
# Platform in segments is detected from hostname (localhost vs *.github.io).
